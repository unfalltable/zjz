# Copy to backend/api/.env; never commit real credentials.
NODE_ENV=development
ACCOUNT_HOST=127.0.0.1
ACCOUNT_PORT=3001
# Optional trusted proxy subnet, e.g. loopback; leave empty for direct access.
ACCOUNT_TRUST_PROXY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
REDIS_URL=redis://127.0.0.1:6379

# Configure only providers you intend to enable. Rotate previously exposed secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/account/google/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:3001/api/account/apple/callback
