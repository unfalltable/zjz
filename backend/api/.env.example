# Copy to backend/api/.env; never commit real credentials.
NODE_ENV=development
ACCOUNT_HOST=127.0.0.1
ACCOUNT_PORT=3002
# Public storefront origin, not the loopback account API address. HTTPS in production.
ACCOUNT_PUBLIC_ORIGIN=http://localhost:5173
# Optional additional explicitly trusted browser origins, comma-separated.
ACCOUNT_ALLOWED_ORIGINS=
# Leave empty for direct access. For the reviewed production same-origin gateway:
# ACCOUNT_TRUST_PROXY=loopback only together with Web ACCOUNT_TRUST_NGINX_IP=true,
# Nginx overwriting client IP headers, and both Node listeners restricted to loopback.
ACCOUNT_TRUST_PROXY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
REDIS_URL=redis://127.0.0.1:6379
ACCOUNT_COOKIE_SECURE=false
# Absolute persistent avatar directory outside release/public/static directories.
ACCOUNT_UPLOAD_PATH=
ACCOUNT_AVATAR_MAX_FILES=20000
ACCOUNT_AVATAR_MAX_BYTES=1073741824
# Unrelated birth/divination data from the supplied bundle is not enabled in the shop.
ACCOUNT_PROFILE_BIRTH_ENABLED=false

# Optional SMTP delivery: no configuration means unavailable, never a simulated send.
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USER=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_EMAIL_FROM=

# Optional SMS delivery. Twilio calls are disabled unless every required field is set.
ACCOUNT_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Configure only providers you intend to enable. Rotate previously exposed secrets.
ACCOUNT_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URLs are derived from ACCOUNT_PUBLIC_ORIGIN, not caller input.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_CLIENT_ID=
